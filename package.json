{
  "name": "wrytrove-editor",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A small, local-first text and code editor for Windows.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test tests/val02-fixtures.node.mjs",
    "test:e2e": "playwright test",
    "benchmark": "vitest bench scripts/performance-baseline.bench.ts",
    "benchmark:json": "vitest bench scripts/performance-baseline.bench.ts --run --reporter=json --outputFile=benchmark-results.json",
    "benchmark:table": "node scripts/benchmark-table.mjs benchmark-results.json",
    "benchmark:engines": "npm --prefix benchmarks/engines run build && node benchmarks/engines/run.mjs",
    "benchmark:products": "node benchmarks/product/run.mjs",
    "benchmark:compare": "node benchmarks/compare.mjs",
    "audit:static": "node scripts/security-audit.mjs",
    "test:val02-fixtures": "node --test tests/val02-fixtures.node.mjs",
    "benchmark:large-file": "node scripts/benchmark-large-file.mjs",
    "study:check": "node scripts/validation/study-evidence.mjs check",
    "study:aggregate": "node scripts/validation/study-evidence.mjs aggregate",
    "study:fixtures": "node scripts/validation/study-evidence.mjs fixtures research/val-05",
    "study:fixtures:write": "node scripts/validation/study-evidence.mjs fixtures research/val-05 --write",
    "tauri": "tauri",
    "ai:eval": "node --import tsx scripts/validation/run-ai-eval.ts",
    "validate:roadmap": "node scripts/validate-roadmap.js .github/roadmap.json",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.scripts-strict.json",
    "roadmap:drift": "node --import tsx scripts/discover.ts .github/roadmap.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.40.0",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "diff": "^9.0.0",
    "markdown-it": "^14.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
